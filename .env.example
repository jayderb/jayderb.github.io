# Server
PORT=4000
# Firebase Hosting origins (add your custom domain here once you have one)
ALLOWED_ORIGINS=https://krinttufwale-001.web.app,https://krinttufwale-001.firebaseapp.com

# Database (on a paid Render instance with a disk, e.g. /var/data/krint.db)
DATABASE_PATH=./data/krint.db

# Auth
JWT_SECRET=replace-with-a-long-random-string

# Seller orders page (admin.html). Leave unset and the page stays disabled.
ADMIN_PASSWORD=choose-a-long-passphrase

# Email
EMAIL_USER=youraddress@gmail.com
EMAIL_PASS=your16charapppassword
CONTACT_TO_EMAIL=hello@krinttufwale.com
ORDER_NOTIFY_EMAIL=orders@krinttufwale.com
# Free Render blocks SMTP: set true there, false or unset once on a paid plan
EMAIL_DISABLED=false