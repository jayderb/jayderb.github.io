# ---- Server ----
PORT=4000

# Comma-separated list of allowed origins (your live frontend + local dev)
# Example: https://krinttufwale.com,https://www.krinttufwale.com,http://localhost:5500
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1,http://127.0.0.1:5500


# ---- Database ----
# Path to the SQLite file. Created automatically on first run.
DATABASE_PATH=./data/krint.db

# ---- Email (SMTP) ----
# Any SMTP provider works: Gmail (app password), SendGrid, Mailgun, Resend, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Where contact form submissions get emailed to (can be same as SMTP_USER)
CONTACT_RECEIVER=jaykalobwe18@gmail.com

# What shows as the "From" name/address in the notification email
CONTACT_FROM_NAME=Krint Tufwale Website
