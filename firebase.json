{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/data/**",
      "**/src/**",
      "**/*.env",
      "**/*.db",
      "**/*.db-*",
      "**/*.log",
      "package.json",
      "package-lock.json",
      "skills-lock.json",
      "serve.dev.js",
      "README.md"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      }
    ]
  }
}